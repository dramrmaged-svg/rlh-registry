{
  "displayName": "integration",
  "testMatch": [
    "**/*.integration.spec.ts"
  ],
  "transform": {
    "^.+\\.ts$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "testEnvironment": "node",
  "globalSetup": "<rootDir>/src/test/global-setup.ts",
  "testTimeout": 30000
}