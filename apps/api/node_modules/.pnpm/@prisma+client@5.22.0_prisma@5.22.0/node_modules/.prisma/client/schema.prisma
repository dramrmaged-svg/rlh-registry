generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSULTANT_IR
  FELLOW
  CNS_COORDINATOR
  DATA_MANAGER
  READ_ONLY
}

enum BiologicalSex {
  MALE
  FEMALE
  INDETERMINATE
  UNKNOWN
}

enum IdentifierType {
  NHS_NUMBER
  MRN_RLH
  MRN_EXTERNAL
  EXTERNAL_REFERRAL_ID
}

enum RecordLockStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AuditEventType {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  LOCK
  UNLOCK
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  ROLE_CHANGED
  MERGE
}

enum BclcStage {
  STAGE_0
  STAGE_A
  STAGE_B
  STAGE_C
  STAGE_D
}

enum ChildPughGrade {
  A
  B
  C
}

// A treatment course/decision for a patient. First SIRT or repeat SIRT are
// both episodes; episode-scoped clinical data (MDT, labs, mapping,
// dosimetry, treatment, follow-up, toxicity) must never be shared or
// overwritten between episodes. See docs/adr/0001-episode-architecture.md.
enum EpisodeStatus {
  REFERRED
  AWAITING_MDT
  MDT_APPROVED
  CLINIC_ASSESSMENT_COMPLETED
  AWAITING_MAPPING
  MAPPING_COMPLETED
  AWAITING_DOSIMETRY
  TREATMENT_APPROVED
  AWAITING_TREATMENT
  TREATMENT_COMPLETED
  EARLY_FOLLOW_UP
  IMAGING_FOLLOW_UP
  COMPLETED
  CANCELLED
  DEFERRED
  NOT_SUITABLE
  LOST_TO_FOLLOW_UP
}

enum EpisodeType {
  FIRST
  REPEAT
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  title        String?
  gmcNumber    String?
  role         Role
  isActive     Boolean   @default(true)
  version      Int       @default(1)
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  createdPatients  Patient[]      @relation("PatientCreatedBy")
  updatedPatients  Patient[]      @relation("PatientUpdatedBy")
  lockedMdtRecords MdtRecord[]    @relation("MdtRecordLockedBy")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Patient {
  id                    String        @id @default(uuid())
  firstName             String
  lastName              String
  dateOfBirth           DateTime      @db.Date
  sex                   BiologicalSex
  ethnicity             String?
  countryOfBirth        String?
  gpPractice            String?
  gpName                String?
  referringHospital     String?
  referringClinician    String?
  nhsNumberPendingUntil DateTime?
  // Canonical, patient-level source of truth for vital status. Individual
  // episodes never duplicate these — see EpisodeOutcome.
  vitalStatus           String?
  dateOfDeath           DateTime?     @db.Date
  isActive              Boolean       @default(true)
  version               Int           @default(1)
  deletedAt             DateTime?
  createdById           String
  updatedById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  createdBy User @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("PatientUpdatedBy", fields: [updatedById], references: [id])

  identifiers PatientIdentifier[]
  episodes    Episode[]

  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid())
  patientId      String
  identifierType IdentifierType
  value          String
  issuingOrg     String?
  isPrimary      Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdById    String
  createdAt      DateTime       @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_identifiers")
}

// A patient's episode of care: one course of SIRT treatment decision-making,
// from referral through to completion/cancellation. A patient with repeat
// SIRT has multiple Episodes, each with its own full clinical/procedural
// data tree below. Never assume one episode per patient.
model Episode {
  id                         String         @id @default(uuid())
  patientId                  String
  episodeNumber              Int
  firstOrRepeat              EpisodeType    @default(FIRST)
  previousEpisodeId          String?
  status                     EpisodeStatus  @default(REFERRED)
  deferredFromStatus         EpisodeStatus?
  referralDate               DateTime?      @db.Date
  referralSource             String?
  referringClinicianOverride String?
  statusChangedAt            DateTime?
  statusChangedById          String?
  version                    Int            @default(1)
  deletedAt                  DateTime?
  createdById                String
  updatedById                String
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt

  patient         Patient   @relation(fields: [patientId], references: [id])
  previousEpisode Episode?  @relation("EpisodeRepeats", fields: [previousEpisodeId], references: [id])
  repeatEpisodes  Episode[] @relation("EpisodeRepeats")

  diagnosis         Diagnosis?
  mdtRecords        MdtRecord[]
  clinicalScores    ClinicalScore[]
  labPanels         LabPanel[]
  clinicalSnapshots ClinicalSnapshot[]
  imagingStudies    ImagingStudy[]
  lesions           Lesion[]
  mappingSessions   MappingSession[]
  dosimetryPlans    DosimetryPlan[]
  treatmentSessions TreatmentSession[]
  followUps         FollowUp[]
  toxicityEvents    ToxicityEvent[]
  outcome           EpisodeOutcome?

  @@unique([patientId, episodeNumber])
  @@index([patientId, status])
  @@map("episodes")
}

// One diagnosis/staging-of-record per episode. Carries calculated (engine
// output) vs confirmed (clinician-entered) values separately for every
// staging system, per the project's calculated/confirmed/override-reason
// convention — a routine recalculation must never silently overwrite a
// clinician-confirmed staging used for treatment decisions.
model Diagnosis {
  id        String @id @default(uuid())
  episodeId String @unique

  tumourType         String
  aetiology          String?
  diagnosisDate      DateTime? @db.Date
  histologyConfirmed Boolean?

  calculatedBclcStage BclcStage?
  confirmedBclcStage  BclcStage?
  bclcOverrideReason  String?

  calculatedTStage  String?
  calculatedNStage  String?
  calculatedMStage  String?
  confirmedTStage   String?
  confirmedNStage   String?
  confirmedMStage   String?
  tnmOverrideReason String?

  calculatedCpScore Int?
  calculatedCpGrade ChildPughGrade?
  confirmedCpGrade  ChildPughGrade?
  cpOverrideReason  String?

  calculatedMeld3Score  Decimal? @db.Decimal(8, 4)
  calculatedMeldNaScore Decimal? @db.Decimal(8, 4)
  meldOverrideReason    String?

  calculatedAlbiScore Decimal? @db.Decimal(8, 4)
  calculatedAlbiGrade Int?
  albiOverrideReason  String?

  calculationVersion String?
  version            Int       @default(1)
  deletedAt          DateTime?
  createdById        String
  updatedById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])

  @@map("diagnoses")
}

// A real-world MDT meeting — never patient- or episode-scoped.
model MdtSession {
  id          String   @id @default(uuid())
  sessionDate DateTime @db.Date
  location    String?
  chair       String?
  createdById String
  createdAt   DateTime @default(now())

  mdtRecords MdtRecord[]

  @@map("mdt_sessions")
}

model MdtRecord {
  id                          String           @id @default(uuid())
  episodeId                   String
  mdtSessionId                String
  clinicalSnapshotId          String?
  diseaseSummary              String?
  priorTreatmentSummary       String?
  decision                    String?
  decisionDetail              String?
  decisionConditions          String?
  patientFitForProcedure      Boolean?
  performanceStatusAcceptable Boolean?
  liverFunctionAcceptable     Boolean?
  tumourLoadAcceptable        Boolean?
  lockStatus                  RecordLockStatus @default(DRAFT)
  submittedAt                 DateTime?
  submittedById               String?
  lockedAt                    DateTime?
  lockedById                  String?
  version                     Int              @default(1)
  deletedAt                   DateTime?
  createdById                 String
  updatedById                 String
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  episode          Episode           @relation(fields: [episodeId], references: [id])
  mdtSession       MdtSession        @relation(fields: [mdtSessionId], references: [id])
  clinicalSnapshot ClinicalSnapshot? @relation(fields: [clinicalSnapshotId], references: [id])
  lockedBy         User?             @relation("MdtRecordLockedBy", fields: [lockedById], references: [id])

  @@unique([episodeId, mdtSessionId])
  @@map("mdt_records")
}

// Serial, repeatable, point-in-time output of the calculation engine within
// an episode — an audit trail of recalculations. Distinct from
// Diagnosis.calculated*/confirmed*, which is the single staging-of-record
// used for treatment eligibility decisions and must not be silently
// overwritten by a routine recalculation here.
model ClinicalScore {
  id                 String          @id @default(uuid())
  episodeId          String
  scoreDate          DateTime        @db.Date
  context            String?
  ecogScore          Int?
  ascites            String?
  encephalopathy     String?
  cpGrade            ChildPughGrade?
  cpTotalScore       Int?
  meld3Score         Decimal?        @db.Decimal(8, 4)
  meldNaScore        Decimal?        @db.Decimal(8, 4)
  meldNaScoreRounded Int?
  albiGrade          Int?
  albiScore          Decimal?        @db.Decimal(8, 4)
  bclcStage          BclcStage?
  bsaM2              Decimal?        @db.Decimal(6, 4)
  weightKg           Decimal?        @db.Decimal(6, 2)
  calculationVersion String?
  createdById        String
  createdAt          DateTime        @default(now())

  episode           Episode            @relation(fields: [episodeId], references: [id])
  clinicalSnapshots ClinicalSnapshot[]

  @@map("clinical_scores")
}

model LabPanel {
  id                       String    @id @default(uuid())
  episodeId                String
  collectedAt              DateTime
  submittedAt              DateTime?
  bilirubinTotalUmolL      Decimal?  @db.Decimal(8, 2)
  albuminGL                Decimal?  @db.Decimal(6, 2)
  inr                      Decimal?  @db.Decimal(6, 3)
  afpNgMl                  Decimal?  @db.Decimal(12, 2)
  plateletsE9L             Decimal?  @db.Decimal(8, 2)
  creatinineUmolL          Decimal?  @db.Decimal(8, 2)
  sodiumMmolL              Decimal?  @db.Decimal(6, 2)
  onDialysis               Boolean?
  dialysisSessionsPastWeek Int?
  createdById              String
  createdAt                DateTime  @default(now())

  episode           Episode            @relation(fields: [episodeId], references: [id])
  clinicalSnapshots ClinicalSnapshot[]

  @@map("lab_panels")
}

// Immutable point-in-time roll-up combining a ClinicalScore + LabPanel,
// used to freeze the clinical picture at MDT-review time (or other contexts
// via snapshotContext).
model ClinicalSnapshot {
  id                  String          @id @default(uuid())
  episodeId           String
  snapshotDate        DateTime        @db.Date
  snapshotContext     String
  clinicalScoreId     String?
  labPanelId          String?
  ecogScore           Int?
  cpGrade             ChildPughGrade?
  cpTotalScore        Int?
  meld3Score          Decimal?        @db.Decimal(8, 4)
  meldNaScore         Decimal?        @db.Decimal(8, 4)
  meldNaScoreRounded  Int?
  albiGrade           Int?
  albiScore           Decimal?        @db.Decimal(8, 4)
  bclcStage           BclcStage?
  bsaM2               Decimal?        @db.Decimal(6, 4)
  weightKg            Decimal?        @db.Decimal(6, 2)
  tumourStatusSummary String?
  calculationVersion  String?
  createdById         String
  createdAt           DateTime        @default(now())

  episode       Episode        @relation(fields: [episodeId], references: [id])
  clinicalScore ClinicalScore? @relation(fields: [clinicalScoreId], references: [id])
  labPanel      LabPanel?      @relation(fields: [labPanelId], references: [id])
  mdtRecords    MdtRecord[]

  @@map("clinical_snapshots")
}

// Single model for baseline/post-mapping/post-treatment/follow-up imaging,
// discriminated by `phase` — deliberately not split into several
// near-duplicate imaging tables.
model ImagingStudy {
  id                 String   @id @default(uuid())
  episodeId          String
  mappingSessionId   String?
  treatmentSessionId String?
  studyDate          DateTime @db.Date
  modality           String
  bodyPart           String?
  phase              String?
  createdById        String
  createdAt          DateTime @default(now())

  episode          Episode           @relation(fields: [episodeId], references: [id])
  mappingSession   MappingSession?   @relation(fields: [mappingSessionId], references: [id])
  treatmentSession TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])
  maaStudies       MaaStudy[]

  @@map("imaging_studies")
}

model Lesion {
  id                     String    @id @default(uuid())
  episodeId              String
  lesionNumber           Int
  segment                String?
  laterality             String?
  isTargetLesion         Boolean   @default(true)
  diameterAxialMm        Decimal?  @db.Decimal(7, 2)
  diameterCraniocaudalMm Decimal?  @db.Decimal(7, 2)
  diameterApMm           Decimal?  @db.Decimal(7, 2)
  calculatedVolumeCm3    Decimal?  @db.Decimal(10, 3)
  lirads                 String?
  notes                  String?
  version                Int       @default(1)
  deletedAt              DateTime?
  createdById            String
  updatedById            String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  episode        Episode               @relation(fields: [episodeId], references: [id])
  feeders        LesionFeeder[]
  followUps      FollowUp[]
  doseInjections LesionDoseInjection[]

  @@unique([episodeId, lesionNumber])
  @@map("lesions")
}

model LesionFeeder {
  id           String   @id @default(uuid())
  lesionId     String
  feederNumber Int
  vesselName   String?
  createdAt    DateTime @default(now())

  lesion         Lesion                @relation(fields: [lesionId], references: [id])
  doseInjections LesionDoseInjection[]

  @@unique([lesionId, feederNumber])
  @@map("lesion_feeders")
}

// Replaces the legacy app's del_L{1-3}F{1-2}_* and tx_L{1-3}F{1-2}_* flat
// field families with a single link table between a treatment session, a
// lesion, and (optionally) a specific feeder vessel.
model LesionDoseInjection {
  id                   String   @id @default(uuid())
  treatmentSessionId   String
  lesionId             String
  lesionFeederId       String?
  deliveredActivityGbq Decimal? @db.Decimal(10, 4)
  deliveredDoseGy      Decimal? @db.Decimal(10, 3)
  particleCount        Decimal? @db.Decimal(14, 2)
  notes                String?
  createdAt            DateTime @default(now())

  treatmentSession TreatmentSession @relation(fields: [treatmentSessionId], references: [id])
  lesion           Lesion           @relation(fields: [lesionId], references: [id])
  lesionFeeder     LesionFeeder?    @relation(fields: [lesionFeederId], references: [id])

  @@unique([treatmentSessionId, lesionId, lesionFeederId])
  @@map("lesion_dose_injections")
}

model MappingSession {
  id               String           @id @default(uuid())
  episodeId        String
  sessionDate      DateTime         @db.Date
  status           String?
  accessRoute      String?
  accessSite       String?
  catheterType     String?
  fluoroTimeMin    Decimal?         @db.Decimal(6, 2)
  dapGyCm2         Decimal?         @db.Decimal(10, 4)
  contrastVolumeMl Decimal?         @db.Decimal(8, 2)
  michelsAnatomy   String?
  embolicMaterial  String?
  complications    String?
  operatorUserId   String?
  lockStatus       RecordLockStatus @default(DRAFT)
  version          Int              @default(1)
  deletedAt        DateTime?
  createdById      String
  updatedById      String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  episode        Episode         @relation(fields: [episodeId], references: [id])
  maaStudies     MaaStudy[]
  imagingStudies ImagingStudy[]
  dosimetryPlans DosimetryPlan[]

  @@map("mapping_sessions")
}

model MaaStudy {
  id                           String   @id @default(uuid())
  mappingSessionId             String
  imagingStudyId               String?
  studyDate                    DateTime @db.Date
  injectedActivityMbq          Decimal? @db.Decimal(10, 3)
  lungShuntFraction            Decimal? @db.Decimal(6, 3)
  calculatedLsfRiskBand        String?
  extrahepaticUptake           Boolean?
  extrahepaticUptakeSites      String?
  maaDistributionMatchesTarget Boolean?
  balanceCheckPass             Boolean?
  calculationVersion           String?
  createdById                  String
  createdAt                    DateTime @default(now())

  mappingSession MappingSession @relation(fields: [mappingSessionId], references: [id])
  imagingStudy   ImagingStudy?  @relation(fields: [imagingStudyId], references: [id])

  @@map("maa_studies")
}

model DosimetryPlan {
  id                               String           @id @default(uuid())
  episodeId                        String
  mappingSessionId                 String?
  planDate                         DateTime         @db.Date
  planningModel                    String
  particleProduct                  String?
  targetLiverVolumeCm3             Decimal?         @db.Decimal(10, 2)
  treatedLiverVolumePercent        Decimal?         @db.Decimal(6, 2)
  tumourLiverVolumeRatio           Decimal?         @db.Decimal(6, 3)
  calculatedPrescribedActivityGbq  Decimal?         @db.Decimal(10, 4)
  confirmedPrescribedActivityGbq   Decimal?         @db.Decimal(10, 4)
  prescribedActivityOverrideReason String?
  particleDensityCalc              Decimal?         @db.Decimal(12, 4)
  lockStatus                       RecordLockStatus @default(DRAFT)
  approvedAt                       DateTime?
  approvedById                     String?
  version                          Int              @default(1)
  deletedAt                        DateTime?
  createdById                      String
  updatedById                      String
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime         @updatedAt

  episode           Episode            @relation(fields: [episodeId], references: [id])
  mappingSession    MappingSession?    @relation(fields: [mappingSessionId], references: [id])
  treatmentSessions TreatmentSession[]

  @@map("dosimetry_plans")
}

model TreatmentSession {
  id                          String           @id @default(uuid())
  episodeId                   String
  dosimetryPlanId             String?
  sessionDate                 DateTime         @db.Date
  sessionNumber               Int
  status                      String?
  accessRoute                 String?
  accessSite                  String?
  catheterType                String?
  fluoroTimeMin               Decimal?         @db.Decimal(6, 2)
  dapGyCm2                    Decimal?         @db.Decimal(10, 4)
  contrastVolumeMl            Decimal?         @db.Decimal(8, 2)
  embolicMaterial             String?
  particleProduct             String?
  administeredActivityGbq     Decimal?         @db.Decimal(10, 4)
  maaBalanceCheckedAtDelivery Boolean?
  complications               String?
  operatorUserId              String?
  lockStatus                  RecordLockStatus @default(DRAFT)
  version                     Int              @default(1)
  deletedAt                   DateTime?
  createdById                 String
  updatedById                 String
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  episode        Episode               @relation(fields: [episodeId], references: [id])
  dosimetryPlan  DosimetryPlan?        @relation(fields: [dosimetryPlanId], references: [id])
  doseInjections LesionDoseInjection[]
  postImaging    ImagingStudy[]
  toxicityEvents ToxicityEvent[]

  @@unique([episodeId, sessionNumber])
  @@map("treatment_sessions")
}

model FollowUp {
  id                String           @id @default(uuid())
  episodeId         String
  lesionId          String?
  followUpDate      DateTime         @db.Date
  intendedTimepoint String?
  intervalMonths    Int?
  visitType         String?
  overallResponse   String?
  lockStatus        RecordLockStatus @default(DRAFT)
  version           Int              @default(1)
  deletedAt         DateTime?
  createdById       String
  updatedById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])
  lesion  Lesion? @relation(fields: [lesionId], references: [id])

  @@map("follow_ups")
}

model ToxicityEvent {
  id                 String           @id @default(uuid())
  episodeId          String
  treatmentSessionId String?
  onsetDate          DateTime?        @db.Date
  toxicityType       String
  ctcaeGrade         Int?
  reildGrade         String?
  outcome            String?
  resolvedDate       DateTime?        @db.Date
  notes              String?
  lockStatus         RecordLockStatus @default(DRAFT)
  version            Int              @default(1)
  deletedAt          DateTime?
  createdById        String
  updatedById        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  episode          Episode           @relation(fields: [episodeId], references: [id])
  treatmentSession TreatmentSession? @relation(fields: [treatmentSessionId], references: [id])

  @@map("toxicity_events")
}

model EpisodeOutcome {
  id                    String    @id @default(uuid())
  episodeId             String    @unique
  outcomeStatus         String?
  progressionDate       DateTime? @db.Date
  progressionReason     String?
  calculatedOsMonths    Decimal?  @db.Decimal(8, 3)
  calculatedPfsMonths   Decimal?  @db.Decimal(8, 3)
  osPfsFormulaVersion   String?
  confirmedOutcomeNotes String?
  calculationVersion    String?
  version               Int       @default(1)
  deletedAt             DateTime?
  createdById           String
  updatedById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id])

  @@map("episode_outcomes")
}

// Full provenance/history trail for calculated values, distinct from the
// typed calculated*/confirmed* columns on individual entities (which stay
// query-able and type-safe for current-state decisions).
model CalculationAudit {
  id             String   @id @default(uuid())
  entityType     String
  entityId       String
  formulaId      String
  formulaVersion String
  inputsSnapshot Json
  result         Json
  status         String
  calculatedAt   DateTime @default(now())
  calculatedById String?

  @@index([entityType, entityId, formulaId, calculatedAt])
  @@map("calculation_audits")
}

model Vocabulary {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  options VocabularyOption[]

  @@map("vocabularies")
}

model VocabularyOption {
  id           String   @id @default(uuid())
  vocabularyId String
  code         String
  label        String
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())

  vocabulary Vocabulary @relation(fields: [vocabularyId], references: [id])

  @@unique([vocabularyId, code])
  @@map("vocabulary_options")
}

model AuditLog {
  id             String         @id @default(uuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  roleAtTime     Role?
  eventType      AuditEventType
  entityType     String
  entityId       String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  changedFields  Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  timestamp      DateTime       @default(now())

  @@index([entityType, entityId, timestamp])
  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([timestamp])
  @@map("audit_logs")
}
