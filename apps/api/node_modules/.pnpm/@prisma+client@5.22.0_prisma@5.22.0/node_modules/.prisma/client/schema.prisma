generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONSULTANT_IR
  FELLOW
  CNS_COORDINATOR
  DATA_MANAGER
  READ_ONLY
}

enum BiologicalSex {
  MALE
  FEMALE
  INDETERMINATE
  UNKNOWN
}

enum IdentifierType {
  NHS_NUMBER
  MRN_RLH
  MRN_EXTERNAL
  EXTERNAL_REFERRAL_ID
}

enum RecordLockStatus {
  DRAFT
  SUBMITTED
  LOCKED
}

enum AuditEventType {
  CREATE
  UPDATE
  DELETE
  SUBMIT
  APPROVE
  LOCK
  UNLOCK
  LOGIN
  LOGIN_FAILED
  LOGOUT
  PASSWORD_RESET
  ROLE_CHANGED
  MERGE
}

enum BclcStage {
  STAGE_0
  STAGE_A
  STAGE_B
  STAGE_C
  STAGE_D
}

enum ChildPughGrade {
  A
  B
  C
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  title        String?
  gmcNumber    String?
  role         Role
  isActive     Boolean   @default(true)
  version      Int       @default(1)
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  createdPatients  Patient[]      @relation("PatientCreatedBy")
  updatedPatients  Patient[]      @relation("PatientUpdatedBy")
  lockedMdtRecords MdtRecord[]    @relation("MdtRecordLockedBy")

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Patient {
  id                    String        @id @default(uuid())
  firstName             String
  lastName              String
  dateOfBirth           DateTime      @db.Date
  sex                   BiologicalSex
  ethnicity             String?
  countryOfBirth        String?
  gpPractice            String?
  gpName                String?
  referringHospital     String?
  referringClinician    String?
  nhsNumberPendingUntil DateTime?
  isActive              Boolean       @default(true)
  version               Int           @default(1)
  deletedAt             DateTime?
  createdById           String
  updatedById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  createdBy User @relation("PatientCreatedBy", fields: [createdById], references: [id])
  updatedBy User @relation("PatientUpdatedBy", fields: [updatedById], references: [id])

  identifiers       PatientIdentifier[]
  diagnoses         Diagnosis[]
  mdtRecords        MdtRecord[]
  treatmentCourses  TreatmentCourse[]
  clinicalScores    ClinicalScore[]
  labPanels         LabPanel[]
  clinicalSnapshots ClinicalSnapshot[]
  followUps         FollowUp[]
  imagingStudies    ImagingStudy[]
  procedures        Procedure[]

  @@map("patients")
}

model PatientIdentifier {
  id             String         @id @default(uuid())
  patientId      String
  identifierType IdentifierType
  value          String
  issuingOrg     String?
  isPrimary      Boolean        @default(false)
  isActive       Boolean        @default(true)
  createdById    String
  createdAt      DateTime       @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("patient_identifiers")
}

model Diagnosis {
  id                String     @id @default(uuid())
  patientId         String
  tumourType        String
  isPrimary         Boolean    @default(true)
  baselineBclcStage BclcStage?
  diagnosisDate     DateTime?  @db.Date
  createdById       String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("diagnoses")
}

model MdtSession {
  id          String   @id @default(uuid())
  sessionDate DateTime @db.Date
  location    String?
  chair       String?
  createdById String
  createdAt   DateTime @default(now())

  mdtRecords MdtRecord[]

  @@map("mdt_sessions")
}

model MdtRecord {
  id                          String           @id @default(uuid())
  patientId                   String
  mdtSessionId                String
  clinicalSnapshotId          String?
  diseaseSummary              String?
  priorTreatmentSummary       String?
  decision                    String?
  decisionDetail              String?
  decisionConditions          String?
  patientFitForProcedure      Boolean?
  performanceStatusAcceptable Boolean?
  liverFunctionAcceptable     Boolean?
  tumourLoadAcceptable        Boolean?
  lockStatus                  RecordLockStatus @default(DRAFT)
  submittedAt                 DateTime?
  submittedById               String?
  lockedAt                    DateTime?
  lockedById                  String?
  version                     Int              @default(1)
  deletedAt                   DateTime?
  createdById                 String
  updatedById                 String
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt

  patient          Patient           @relation(fields: [patientId], references: [id])
  mdtSession       MdtSession        @relation(fields: [mdtSessionId], references: [id])
  clinicalSnapshot ClinicalSnapshot? @relation(fields: [clinicalSnapshotId], references: [id])
  lockedBy         User?             @relation("MdtRecordLockedBy", fields: [lockedById], references: [id])

  @@unique([patientId, mdtSessionId])
  @@map("mdt_records")
}

model ClinicalScore {
  id                 String          @id @default(uuid())
  patientId          String
  scoreDate          DateTime        @db.Date
  ecogScore          Int?
  cpGrade            ChildPughGrade?
  cpTotalScore       Int?
  meldNaScore        Decimal?        @db.Decimal(8, 4)
  meldNaScoreRounded Int?
  albiGrade          Int?
  albiScore          Decimal?        @db.Decimal(8, 4)
  bclcStage          BclcStage?
  bsaM2              Decimal?        @db.Decimal(6, 4)
  weightKg           Decimal?        @db.Decimal(6, 2)
  calculationVersion String?
  createdById        String
  createdAt          DateTime        @default(now())

  patient           Patient            @relation(fields: [patientId], references: [id])
  clinicalSnapshots ClinicalSnapshot[]

  @@map("clinical_scores")
}

model LabPanel {
  id                  String    @id @default(uuid())
  patientId           String
  collectedAt         DateTime
  submittedAt         DateTime?
  bilirubinTotalUmolL Decimal?  @db.Decimal(8, 2)
  albuminGL           Decimal?  @db.Decimal(6, 2)
  inr                 Decimal?  @db.Decimal(6, 3)
  afpNgMl             Decimal?  @db.Decimal(12, 2)
  plateletsE9L        Decimal?  @db.Decimal(8, 2)
  creatinineUmolL     Decimal?  @db.Decimal(8, 2)
  sodiumMmolL         Decimal?  @db.Decimal(6, 2)
  createdById         String
  createdAt           DateTime  @default(now())

  patient           Patient            @relation(fields: [patientId], references: [id])
  clinicalSnapshots ClinicalSnapshot[]

  @@map("lab_panels")
}

model ClinicalSnapshot {
  id                  String          @id @default(uuid())
  patientId           String
  snapshotDate        DateTime        @db.Date
  snapshotContext     String
  clinicalScoreId     String?
  labPanelId          String?
  ecogScore           Int?
  cpGrade             ChildPughGrade?
  cpTotalScore        Int?
  meldNaScore         Decimal?        @db.Decimal(8, 4)
  meldNaScoreRounded  Int?
  albiGrade           Int?
  albiScore           Decimal?        @db.Decimal(8, 4)
  bclcStage           BclcStage?
  bsaM2               Decimal?        @db.Decimal(6, 4)
  weightKg            Decimal?        @db.Decimal(6, 2)
  tumourStatusSummary String?
  calculationVersion  String?
  createdById         String
  createdAt           DateTime        @default(now())

  patient       Patient        @relation(fields: [patientId], references: [id])
  clinicalScore ClinicalScore? @relation(fields: [clinicalScoreId], references: [id])
  labPanel      LabPanel?      @relation(fields: [labPanelId], references: [id])
  mdtRecords    MdtRecord[]

  @@map("clinical_snapshots")
}

model TreatmentCourse {
  id          String   @id @default(uuid())
  patientId   String
  startedAt   DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())

  patient    Patient     @relation(fields: [patientId], references: [id])
  procedures Procedure[]

  @@map("treatment_courses")
}

model Procedure {
  id                String           @id @default(uuid())
  patientId         String
  treatmentCourseId String
  procedureType     String
  laterality        String
  plannedDate       DateTime?        @db.Date
  actualDate        DateTime?        @db.Date
  sessionStatus     String?
  lockStatus        RecordLockStatus @default(DRAFT)
  version           Int              @default(1)
  deletedAt         DateTime?
  createdById       String
  updatedById       String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  patient         Patient         @relation(fields: [patientId], references: [id])
  treatmentCourse TreatmentCourse @relation(fields: [treatmentCourseId], references: [id])

  @@map("procedures")
}

model FollowUp {
  id           String           @id @default(uuid())
  patientId    String
  followUpDate DateTime         @db.Date
  lockStatus   RecordLockStatus @default(DRAFT)
  version      Int              @default(1)
  deletedAt    DateTime?
  createdById  String
  updatedById  String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("follow_ups")
}

model ImagingStudy {
  id          String   @id @default(uuid())
  patientId   String
  studyDate   DateTime @db.Date
  modality    String
  bodyPart    String?
  createdById String
  createdAt   DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("imaging_studies")
}

model AuditLog {
  id             String         @id @default(uuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id])
  roleAtTime     Role?
  eventType      AuditEventType
  entityType     String
  entityId       String?
  beforeSnapshot Json?
  afterSnapshot  Json?
  changedFields  Json?
  ipAddress      String?
  userAgent      String?
  metadata       Json?
  timestamp      DateTime       @default(now())

  @@index([entityType, entityId, timestamp])
  @@index([userId, timestamp])
  @@index([eventType, timestamp])
  @@index([timestamp])
  @@map("audit_logs")
}
